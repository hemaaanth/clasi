{
  "name": "clasi",
  "version": "0.1.0",
  "description": "Continuous learning and self-improvement for OMP",
  "type": "module",
  "keywords": [
    "omp",
    "oh-my-pi",
    "pi-coding-agent",
    "coding-agent",
    "memory",
    "developer-tools"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "clasi": "./bin/clasi.ts"
  },
  "files": [
    "bin",
    "skills",
    "src",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 15000",
    "smoke:host": "bun scripts/smoke-host.ts",
    "smoke:omp": "bun scripts/smoke-omp.ts",
    "test:concurrency": "bun test test/concurrency.test.ts",
    "test:privacy": "bun test test/privacy.test.ts",
    "model:eval": "bun scripts/model-eval.ts",
    "release:validate": "bun scripts/release-validate.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.2.4 <18"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.2.4",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
